{
    "jdk.jdkhome": "/home/ljw/wuqiang/sx/rearr/.jdk/Oracle_JDK-24",
    // The order to use for the file comment. Values can be used multiple times. Valid values are shown in default setting.
    "doxdocgen.file.fileOrder": [
        "file",
        "author",
        "brief",
        "date",
        "empty",
        "copyright",
        "empty",
        "custom"
    ],
    // Set the e-mail address of the author.  Replaces {email}.
    "doxdocgen.generic.authorEmail": "ljw2017@sjtu.edu.cn",
    // Set the name of the author.  Replaces {author}.
    "doxdocgen.generic.authorName": "Jingwei Li",

    "r.rterm.linux": "${workspaceFolder}/.conda/bin/R",
    "r.rpath.linux": "${workspaceFolder}/.conda/bin/R",

    "terminal.integrated.env.linux": {
        "PATH": "${env:PATH}:${workspaceFolder}/.jdk/Oracle_JDK-24/bin:${workspaceFolder}/paper/tools/novocraft:${workspaceFolder}/paper/tools/bam2mpg-1.0.1/scripts",
        "JAVA_HOME": "${workspaceFolder}/.jdk/Oracle_JDK-24",
        "CLASSPATH": "${workspaceFolder}/paper/tools/SIQ-1.8/SIQ/libraries/*:${workspaceFolder}/paper/tools/SIQ-1.8/SIQ/src"
    }
}