FROM python:3
LABEL maintainer="ljw2017@sjtu.edu.cn"
LABEL org.opencontainers.image.source=https://github.com/ljw20180420/rearr
LABEL org.opencontainers.image.description="container runs rearr"
LABEL org.opencontainers.image.licenses=MIT
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        gawk \
        samtools \
        bedtools \
        bowtie2 && \
    apt-get clean
RUN pip install -U pip && \
    pip install \
        cutadapt \
        numpy \
        celery[redis] && \
    pip cache purge
COPY ["./core", "/source/core"]
COPY ["./sx", "/source/sx"]
COPY ["./runWorkFlow.sh", "./workFlow.mak", "./install.sh", "/source/"]
RUN prefix="/usr/local" /source/install.sh && rm -rf /source
